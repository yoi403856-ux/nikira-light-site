# Скопируйте этот файл в .env.local и подставьте свои значения.
# Пока проект Sanity не указан, сайт работает, но остаётся пустым:
# котов, котят и отзывов брать неоткуда.

# Идентификатор проекта Sanity. Виден в sanity.io/manage → ваш проект → API.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-07-01

# Настоящий адрес сайта. Из него собираются sitemap.xml, hreflang и превью
# для мессенджеров, поэтому на проде он обязателен.
NEXT_PUBLIC_SITE_URL=https://nikiralight.ru

# Общий секрет, который проверяет app/api/revalidate/route.js. Ровно это же
# значение нужно вписать в вебхук Sanity — в заголовок x-webhook-secret.
# Секрет для прода придумайте свой, не тот, что используется в разработке.
SANITY_REVALIDATE_SECRET=
